# --- Datenbank (Supabase: Settings → Database → URI) ---
# Session/Direct oft Port 5432; Pooler Port 6543 für viele kurze Verbindungen
# Sonderzeichen im Passwort (@ # ! % …) URL-encoden. Test: python scripts/test_db_connection.py
# flask db upgrade: bei Auth-Fehlern Direct-URI (Host db.<ref>.supabase.co) statt Pooler testen
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# --- Flask ---
# Wichtig: Niemals FLASK_APP=backend.app setzen (Import-Fehler). Nutze app:app oder scripts/flask_cli.sh
FLASK_APP=app:app
FLASK_ENV=development
FLASK_DEBUG=1
# Zufälliger String für Sessions (Production setzen!)
FLASK_SECRET_KEY=

# --- Clerk (Auth) ---
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Pflicht. Ohne diesen Wert lehnt das Backend jedes Token mit 401 ab; es gibt
# bewusst keinen Fallback auf die Dev-Instanz (helpers/clerk_auth.py).
# Beispiel: https://clerk.pepeshows.de/.well-known/jwks.json
CLERK_JWKS_URL=
# Optional. Gesetzt, muss der iss-Claim exakt passen.
CLERK_ISSUER=

# --- Vercel Blob (Bild- und Rechnungsupload) ---
# Pflicht, sobald jemand ein Profilbild, ein Galeriebild oder eine Rechnung
# hochladen soll — also praktisch immer. Fehlt der Wert, antwortet
# /api/upload/image mit 500 "Storage not configured", und im Log steht
# "BLOB_READ_WRITE_TOKEN not set".
# Seit SPEC-4 lädt ausschliesslich das Backend hoch. In frontend/.env hat das
# Token nichts mehr verloren, dort liest es niemand mehr.
# Produktion: Environment Variables des Vercel-Projekts `pepe-services`.
# Wert zu finden im Vercel-Dashboard: Storage → Blob → <Store> → Tokens
BLOB_READ_WRITE_TOKEN=

# --- Supabase (Storage / Admin API, nicht Auth ersetzen) ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Legacy-Alias im Code:
SUPABASE_SERVICE_ROLE=

# --- E-Mail ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ADMIN_EMAIL=
APP_URL=https://pepeshows.de

# --- CORS (Browser-Zugriff vom Frontend) ---
# Produktion: Frontend und Backend liegen als zwei Services in einem Vercel-Projekt
# auf derselben Herkunft, CORS entfällt dort. Nötig bleibt es für lokale Entwicklung
# gegen ein entferntes Backend und für Preview-URLs.
# Kommaseparierte Origins. Wenn leer: app.py nutzt Fallback inkl. http://localhost:* .
# In Production: alle Frontend-Origins eintragen (Vercel, Custom-Domain). Sonst blockt der Browser (CORS).
# Für lokales Vite ggf. ergänzen:
# CORS_ORIGINS=https://pepeshows.de,https://*.vercel.app,http://localhost:5173,http://localhost:5174,http://127.0.0.1:5174
CORS_ORIGINS=

# --- Sonstiges ---
AGENCY_FEE_PERCENT=20
