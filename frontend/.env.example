# --- Auth (Clerk) ---------------------------------------------------------
# Publishable Key der aktiven Clerk-Instanz (pk_test_… für Dev, pk_live_… für Prod).
# Ohne diesen Wert bricht der Start mit "Missing VITE_CLERK_PUBLISHABLE_KEY" ab.
VITE_CLERK_PUBLISHABLE_KEY=
# Name des JWT-Templates im Clerk-Dashboard. Das Template muss die Claims
# `email`, `name` und `public_metadata` liefern — ohne `email` kann das Backend
# beim ersten Login keinen Artist-Datensatz anlegen.
VITE_CLERK_JWT_TEMPLATE=pepe-backend

# --- Backend ---------------------------------------------------------------
# Pflicht für API-Calls: lokal z. B. http://127.0.0.1:5000
# Production: z. B. https://pepe-backend-xxxx.onrender.com (Render).
# Backend CORS_ORIGINS entsprechend anpassen.
VITE_API_URL=
VITE_PUBLIC_SITE_URL=

# --- Analytics / Misc ------------------------------------------------------
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
VITE_ENABLE_ANALYTICS=
VITE_TURNSTILE_SITE_KEY=
VITE_APP_GOOGLE_CLIENT_ID=
VITE_INSTAGRAM_ACCESS_TOKEN=

# Hinweis: Secrets (CLERK_SECRET_KEY, SHADCNBLOCKS_API_KEY, Storage-Tokens)
# gehören ausschliesslich in die lokale .env bzw. in die Secret-Verwaltung des
# Hosters — niemals in wrangler.toml oder eine andere eingecheckte Datei.
